APP_NAME="RENTRI CRM Demo"
APP_ENV=demo
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# --- Demo platform (required) ---
APP_DEMO_MODE=true
RENTRI_DEMO_FORCE_SANDBOX=true
RENTRI_DEMO_NO_HTTP=true

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# CI/staging: override DB_* in pipeline (PostgreSQL service or sqlite)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rentri_crm_demo
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# RENTRI — sandbox stub (no cert required in demo CI)
RENTRI_BASE_URL_SANDBOX=https://demoapi.rentri.gov.it
RENTRI_BASE_URL_PRODUCTION=https://api.rentri.gov.it
RENTRI_API_STUB=true
RENTRI_FIRMA_STUB=true
RENTRI_AUTH_MODE=mtls
RENTRI_VERIFY_SSL=true

VITE_APP_NAME="${APP_NAME}"
