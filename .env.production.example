APP_NAME="RENTRI CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.example.it

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# PostgreSQL (required in production)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rentri_crm
DB_USERNAME=rentri_app
DB_PASSWORD=change-me

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.it"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Audit
ACTIVITYLOG_ENABLED=true

# Horizon
HORIZON_PATH=horizon

# --- RENTRI production ---
RENTRI_ENV=production
RENTRI_API_STUB=false
RENTRI_BASE_URL=
RENTRI_CLIENT_ID=
RENTRI_CLIENT_SECRET=
RENTRI_CERT_PATH=/secure/rentri/operatore.p12
RENTRI_KEY_PATH=
