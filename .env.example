APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# --- Demo platform (Ciclo 3) ---
# Istanza demo: APP_DEMO_MODE=true + deploy/env separato (.env.demo)
APP_DEMO_MODE=false
ALLOW_SESSION_DEMO=false
RENTRI_DEMO_FORCE_SANDBOX=true
RENTRI_DEMO_NO_HTTP=false
# Preset sandbox UI (opzionali — valori reali via wizard / upload cert)
# RENTRI_DEMO_PRESET_CF=
# RENTRI_DEMO_PRESET_CF_OPERATORE=
# RENTRI_DEMO_PRESET_PIVA=
# RENTRI_DEMO_PRESET_RAGIONE_SOCIALE=
# RENTRI_DEMO_PRESET_NUM_ISCR_SITO=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Produzione: LOG_CHANNEL=stack_prod LOG_STACK_PROD=json_daily,rentri,security,integration,business
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# Application logs consultabili (Sprint 121)
APP_LOG_PERSIST_DB=true
APP_LOG_RETENTION_DAYS=90
APP_LOG_EXPORT_MAX_DAYS=30

DB_CONNECTION=sqlite

# PostgreSQL (production / staging)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=rentri_crm
# DB_USERNAME=postgres
# DB_PASSWORD=

# MySQL (legacy — not used by default)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Notifiche email (Sprint 99 — stub default, SMTP live prep)
NOTIFICATIONS_LIVE=false
# NOTIFICATIONS_QUEUE=false
# NOTIFICATIONS_SMTP_RATE_LIMIT_PER_MINUTE=30
# NOTIFICATIONS_SMTP_DAILY_CAP=500
# HORIZON_MIN_WORKERS=3
# Per produzione: NOTIFICATIONS_LIVE=true, NOTIFICATIONS_QUEUE=true, QUEUE_CONNECTION=redis, MAIL_MAILER=smtp

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- RENTRI ---
RENTRI_ENV=sandbox
RENTRI_BASE_URL_SANDBOX=https://demoapi.rentri.gov.it
RENTRI_BASE_URL_PRODUCTION=https://api.rentri.gov.it
RENTRI_API_STUB=true
RENTRI_FIRMA_STUB=true
RENTRI_AUTH_MODE=mtls
RENTRI_VERIFY_SSL=true
RENTRI_HTTP_TIMEOUT=30
RENTRI_FIR_POLL_MAX_ATTEMPTS=15
RENTRI_FIR_POLL_INTERVAL_MS=200
RENTRI_FIR_PROGRESSIVO_MAX=9999
RENTRI_REGISTRO_POLL_MAX_ATTEMPTS=15
RENTRI_REGISTRO_POLL_INTERVAL_MS=200
RENTRI_XFIR_POLL_MAX_ATTEMPTS=20
RENTRI_XFIR_POLL_INTERVAL_MS=300
RENTRI_INTEGRATION_TEST=false
# Percorso PKCS#12 sandbox MASE (solo locale/CI gated — mai committare certificati reali)
# RENTRI_SANDBOX_CERT_PATH=/path/to/sandbox-operatore.p12
# RENTRI_SANDBOX_CERT_PASSWORD=
# Test integrazione produzione (Sprint 111 — mai in CI default senza secrets)
RENTRI_PRODUCTION_INTEGRATION_TEST=false
# RENTRI_PRODUCTION_CERT_PATH=/path/to/produzione-operatore.p12
# RENTRI_PRODUCTION_CERT_PASSWORD=

# Retry automatico transazioni MASE fallite (fir/xfir/registro)
RENTRI_RETRY_ENABLED=true
RENTRI_RETRY_MAX_ATTEMPTS=5
RENTRI_RETRY_BASE_DELAY_SECONDS=60
RENTRI_RETRY_MAX_DELAY_SECONDS=3600

# SLA dashboard RENTRI (Sprint 93 — soglie opzionali)
RENTRI_SLA_P95_LATENCY_SECONDS=120
RENTRI_SLA_DEAD_LETTER_RATE_PERCENT=5
RENTRI_SLA_MAX_AVG_RETRY_COUNT=1

# Percorso schema XSD xFIR MASE v1.0 (default: resources/schemas/rentri/xfir-v1.0.xsd)
# RENTRI_XFIR_SCHEMA_PATH=

# MUD invio telematico (Sprint 95/101 — stub default, gateway RENTRI-aligned)
MUD_TELEMATICO_STUB=true
MUD_TELEMATICO_ENV=sandbox
# Default base: demoapi.rentri.gov.it (sandbox) / api.rentri.gov.it (production) via RENTRI_BASE_URL_*
# MUD_TELEMATICO_BASE_URL=
# MUD_TELEMATICO_SUBMIT_PATH=/mud/v1.0/dichiarazioni/trasmissione
# Portale presentazione manuale MASE: https://www.mudtelematico.it
# MUD_TELEMATICO_TIMEOUT=30

# E-commerce pagamenti (Sprint 96/103 — stub default, Stripe sandbox/produzione)
ECOMMERCE_PAYMENT_STUB=true
# STRIPE_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=eur
# STRIPE_LIVE_MODE=false
# Produzione: STRIPE_LIVE_MODE=true + STRIPE_KEY=sk_live_...
# STRIPE_DISPUTE_WEBHOOK_SECRET=whsec_...
# STRIPE_DISPUTE_STUB=true
# STRIPE_RECONCILIATION_DAYS=30

# 2FA enforcement (Sprint 97 — default off; operatore escluso)
TWO_FACTOR_OPTIONAL=true
TWO_FACTOR_ENFORCE_ADMIN_SEGRETERIA=false
# TWO_FACTOR_ENFORCE_GRACE_UNTIL=2026-07-01T00:00:00+02:00
# TWO_FACTOR_ISSUER="ERP VFU"

# WAF edge deploy (Sprint 105 — off locale/dev; monitor → block su staging/prod)
WAF_MODE=off
# WAF_MODE=monitor
# WAF_MODE=block
# WAF_PROVIDER=aws
# WAF_SIEM_LOG_GROUP=/aws/waf/rentri-crm-staging
# WAF_MONITOR_HOURS_BEFORE_BLOCK=48

# HA / backup (Sprint 108 — multi-istanza + restore drill)
# DB_BACKUP_SCHEDULE_ENABLED=false
# DB_BACKUP_CRON="0 2 * * *"
# DB_BACKUP_RETENTION_DAYS=30
# DB_BACKUP_STORAGE_PATH=s3://rentri-crm-backups/staging
# DB_BACKUP_LAST_DRILL_AT=2026-06-01
# HA_RPO_MINUTES=60
# HA_RTO_MINUTES=240
# HA_MIN_APP_INSTANCES=2
# HA_SESSION_REDIS_REQUIRED=false
# HA_PRIMARY_APP_URL=https://app1.staging.example.com
# HA_SECONDARY_APP_URL=https://app2.staging.example.com
# HA_LAST_FAILOVER_DRILL_AT=2026-06-01
# HA_FAILOVER_DRILL_INTERVAL_MONTHS=6

# KPI business v3 (Sprint 119)
# KPI_BUSINESS_ORDINI_WARN=5
# KPI_BUSINESS_ORDINI_ALERT=1
# KPI_BUSINESS_VFU_WARN=8
# KPI_BUSINESS_VFU_ALERT=2
# KPI_BUSINESS_MAGAZZINO_WARN=500
# KPI_BUSINESS_MAGAZZINO_ALERT=100
# KPI_BUSINESS_REVENUE_WARN=500
# KPI_BUSINESS_REVENUE_ALERT=100
# KPI_BUSINESS_ALERT_ENABLED=true
# KPI_BUSINESS_ALERT_PERIOD=last_7_days

# Tracking GPS trasporti (Sprint 98/102 — stub default, provider live + field map)
TRASPORTO_GPS_STUB=true
TRASPORTO_GPS_PROVIDER_URL=https://gps-provider.example.com/api/v1
# TRASPORTO_GPS_API_KEY=
# TRASPORTO_GPS_POSITIONS_PATH=/trasporti/{id}/position
# TRASPORTO_GPS_FIELD_LAT=latitude
# TRASPORTO_GPS_FIELD_LNG=longitude
# TRASPORTO_GPS_FIELD_RECORDED_AT=recorded_at
# TRASPORTO_GPS_FIELD_SPEED=speed_kmh
# Nested example: TRASPORTO_GPS_FIELD_LAT=location.lat TRASPORTO_GPS_FIELD_LNG=location.lng
# TRASPORTO_GPS_GEOFENCE_ENABLED=false
# TRASPORTO_GPS_GEOFENCE_RADIUS_KM=50
# TRASPORTO_GPS_PROBE_TRANSPORT_ID=0
# TRASPORTO_GPS_TIMEOUT=15
